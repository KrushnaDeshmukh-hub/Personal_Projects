

#include <iostream>
using namespace std ;

int main()
{
	int matrix [3][3];
	int i;
	int j;

	for ( i=0 ; i<3; i++)  {                            // i is for row
		for ( j=0; j<3; j++)  {                          //j is for column
			cout<< "enter value for place ("<< i<<","<<j<< ")"<< endl;
			cin >> matrix[i][j];

		}
	}
	for ( i=0 ; i<3; i++)  {
		for ( j=0; j<3; j++)  {
			cout <<"| "<< matrix[i][j]<<"|" ;
		}
		cout << endl;
	}
	return 0;
}
