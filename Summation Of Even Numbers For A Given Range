#include <iostream>
using namespace std ;

int main()
{
  int start;
  cout << "Enter Starting Point Of Range: ";
  cin >> start;
  int end;
  cout << "Enter Ending Point Of Range: ";
  cin >> end;
  int total = 0;
 for(int i=start ;i<=end ;i ++){
     if (i%2 == 0){
         total = total + i;
     }
 }
  cout << "The Summation Of Even Numbers In The Given Range Is: " << total ;
    return 0;
}
