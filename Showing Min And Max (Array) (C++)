
#include <iostream>
using namespace std;
int main()
{
	int m;
	cout << "input the numbers of elements you want in list/arrey : ";
	cin >> m;
	int list[m];

	for (int i=0; i<m; i++)  {
		cout << "put the values of each place of the arrey : ";
		cin >> list[i];
	}
	int max = list [0];
	int min = list [0];

	for (int i=0; i<m; i++) {
		if(max<list[i])  {
			max = list[i];
		}
	}

	cout << "the maximum of the list is : "<< max << endl;

	for (int i=0; i<m; i++) {
		if(min>list[i])  {
			min = list[i];
		}
	}

	cout << "the minimum of the list is : "<< min;

    return 0;
    }
