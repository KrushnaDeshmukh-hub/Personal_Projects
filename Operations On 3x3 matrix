
#include <iostream>
using namespace std ;

int main()
{
	int i;
	int j;
	int matrix1[3][3];
	int matrix2[3][3];
	int result[3][3];
	char oparation_type ;
	cout<<" Oparation Wanted On The Matrixes "<<endl; // enter which oparation you wannna do on the matrixes
	cin>> oparation_type;
	for ( i=0 ; i<3; i++)  {                            // i is for row
		for ( j=0; j<3; j++)  {                          //j is for column
			cout<< "enter value for place ("<< i<<","<<j<<")" ;
			cin >> matrix1[i][j];

		}
		cout<<endl;
	}

	for ( i=0 ; i<3; i++)  {                            // i is for row
		for ( j=0; j<3; j++)  {                         //j is for column
			cout<< "enter value for place ("<< i<<","<<j<<")";
			cin >> matrix2[i][j];
		}
		cout<< endl;
	}
	switch(oparation_type) {

	case '+':
		for(i=0; i<3; i++) {
			for (j=0; j<3; j++) {

				result[i][j] = matrix1[i][j] + matrix2[i][j];
				cout<< "|"<<result[i][j]<<"|";
			}
			cout<< endl;
		}
		break;

	case '-':
		for(i=0; i<3; i++) {
			for (j=0; j<3; j++) {

				result[i][j] = matrix1[i][j] - matrix2[i][j];
				cout<< "|"<<result[i][j]<<"|";
			}
			cout<<endl;
		}
		break;
		
	case '*':
		for(i=0; i<3; i++) {
			for (j=0; j<3; j++) {
                result[i][j] = 0;
            for(int k=0;k<3;k++){    
				result[i][j] = result[i][j] + matrix1[i][k] * matrix2[k][j] ;
               }
				cout<< "|"<<result[i][j]<<"|";
			}
			cout<<endl;
		}
		break;

		
	}
	return 0;
}
